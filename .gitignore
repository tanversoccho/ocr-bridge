# Dependencies — always regenerated by `npm install`
node_modules/

# Environment / secrets — NEVER commit these
.env
.env.local
*.key.json
service-account*.json
google-credentials*.json

# Tesseract language models — large binaries, auto-downloaded
*.traineddata
engine/

# Logs and debug output
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-generated junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE folders
.vscode/
.idea/
*.swp
*.swo

# Temp and cache files
.cache/
tmp/
temp/
*.tmp

# Build output (if you add a bundler later)
dist/
build/
